{
  "name": "manga-panel-studio",
  "version": "0.1.11",
  "description": "Manga OCR proofreading canvas with dubbing pipeline (Node backend + vanilla JS frontend, zero npm runtime deps)",
  "bin": {
    "manga-panel-studio": "bin/cli.mjs"
  },
  "scripts": {
    "start": "node server/canvas.mjs",
    "postinstall": "node bin/setup-check.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "files": [
    "bin",
    "server",
    "!server/__pycache__",
    "public",
    "skills",
    "!skills/**/__pycache__",
    "settings.example.json",
    "README.md"
  ],
  "keywords": [
    "manga",
    "ocr",
    "comic",
    "canvas",
    "agent-skills"
  ],
  "license": "MIT"
}
