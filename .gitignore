# 画布数据（每个会话的图片和历史，体积大、会不断变化）
sessions/

# Python 缓存
__pycache__/
*.pyc

# 临时文件
.tmp-*
*.log
.backup

# CodeGraph 索引（可随时重建）
.codegraph/

# 浏览器调试配置（Chrome 自动生成，随时可重建）
.cdp-panel/
.cdp/
.cdp-*/

# 本地密钥与用户数据（现在默认在 ~/.manga-panel-studio/settings.json，仓库里只留模板）
settings.json

# 协作认领状态（本机临时状态，别提交）
.coord/

# 技能目录里的临时调试脚本（下划线开头的 py 一律不入库）
skills/*/scripts/_*.py

# npm 相关
node_modules/
package-lock.json

# 用户数据目录（阶段 1b 后数据搬到用户目录，这里兜底防误提交）
sessions/

# npm 凭据（本地临时，发布后删除）
.npmrc
